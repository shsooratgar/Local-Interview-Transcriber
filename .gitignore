# =====================================================================
#  CONFIDENTIAL DATA — never commit interviews, transcripts, or outputs
# =====================================================================
data/*
!data/README.md
output/*
!output/README.md

# Local working folders holding real recordings or transcripts
/Audios/
/Experiment/
/Not reviewed transcripts/

# Local config (may contain paths/names) and the real glossary.
# ROOT-ANCHORED on purpose: the Windows bundle's config.yaml MUST be tracked
# (an unanchored pattern once shipped configless bundles — TEST-REPORT.md BUG 2)
/config.yaml
glossary/*.txt
!glossary/*.example.txt

# Audio / transcript / document files anywhere (defense in depth)
*.mp3
*.wav
*.m4a
*.mp4
*.aac
*.flac
*.ogg
*.vtt
*.srt
*.html
*.docx
*.xlsx

# =====================================================================
#  Python
# =====================================================================
__pycache__/
*.py[cod]
.venv/
venv/
.env

# =====================================================================
#  Models / large caches
# =====================================================================
models/
*.gguf
*.bin

# =====================================================================
#  macOS / editors
# =====================================================================
.DS_Store
.vscode/
.idea/
